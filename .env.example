# MedSure Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database: PostgreSQL for Docker/Cloud, defaults to SQLite for local development
DATABASE_URL=postgresql://medsure:medsure_password@localhost:5432/medsure_db
# For local dev without Postgres: sqlite:///./medsure.db

# Authentication
JWT_SECRET=super_secret_jwt_key_powerbank_hackathon_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (supports 'gemini', 'openai', or fallback)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Firebase Cloud Messaging (optional, in-app polling queue is active fallback)
FIREBASE_CREDENTIALS_PATH=

# OCR Provider (options: pymupdf, tesseract, vision)
OCR_PROVIDER=pymupdf
OCR_CONFIDENCE_THRESHOLD=0.70

# Storage
UPLOAD_DIR=./uploads
